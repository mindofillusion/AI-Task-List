{
  "manifest_version": 3,
  "name": "AI Task List – ChatGPT Web",
  "description": "Relays visible ChatGPT activity indicators to the local AI Task List collector.",
  "version": "0.3.0",
  "key": "",
  "permissions": ["nativeMessaging", "storage"],
  "incognito": "not_allowed",
  "action": { "default_popup": "panel.html", "default_title": "AI Task List" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*"],
    "js": ["activity.js"],
    "run_at": "document_idle"
  }]
}
